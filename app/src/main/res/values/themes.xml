<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HomeHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Fix white flash and improve transitions -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>

    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in_slow</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slow</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slow</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out_slow</item>
    </style>

    <style name="Theme.HomeHub" parent="Base.Theme.HomeHub" />

    <!-- Bottom Navigation Style -->
    <style name="BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemBackground">@color/background</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

    <style name="RoundedDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MyAlertDialogStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MyAlertDialogTitleTextStyle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MyAlertDialogBodyTextStyle</item>
    </style>

    <style name="MyAlertDialogStyle" parent="MaterialAlertDialog.Material3">
        <item name="backgroundInsetStart">16dp</item>
        <item name="backgroundInsetEnd">16dp</item>
        <item name="shapeAppearance">@style/MyShapeAppearance</item>
    </style>

    <style name="MyShapeAppearance" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="MyAlertDialogTitleTextStyle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="TextAppearance.BoldTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="MyAlertDialogBodyTextStyle" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    
    <!-- MIGRATED FROM HOMEVIEW: -->
    <!-- Branded Splash Theme: Emerald Green -->
    <style name="Theme.HomeView.SplashBranded" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@null</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Rounded Bottom Corners for Dashboard Header -->
    <style name="ShapeAppearance.RoundedBottom" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">12dp</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="ShapeAppearance.RoundedBottom.Compact" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">13dp</item>
        <item name="cornerSizeBottomRight">13dp</item>
    </style>

    <style name="ShapeAppearance.RoundedTop" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">40dp</item>
        <item name="cornerSizeTopRight">40dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
    <!-- Custom Bottom Sheet Theme -->
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- House Image Rounding for Transitions -->
    <style name="ShapeAppearance.App.HouseImage" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Squircle FAB Shape -->
    <style name="ShapeAppearance.App.FAB.Squircle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">25%</item>
    </style>

    <!-- Circular Image Shape -->
    <style name="CircleImage" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Tab Text Appearance -->
    <!-- Custom Pill TabLayout Style -->
    <style name="PremiumTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicator">@drawable/bg_tab_pill</item>
        <item name="tabIndicatorGravity">center</item>
        <item name="tabIndicatorHeight">38dp</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
        <item name="tabSelectedTextColor">@color/primary_dark</item>
        <item name="tabTextColor">@color/grey_500</item>
        <item name="tabRippleColor">@android:color/transparent</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Generic Corner Radius Styles for ShapeAppearanceOverlay -->
    <style name="CornerRadius12" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CornerRadius16" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="CornerRadius20" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RoundedImage" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

</resources>