<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/subtle_rule_background">

    <!-- Checkbox/Tick Icon -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle"
        android:contentDescription="Rule"
        app:tint="@color/primary_dark"
        android:layout_marginEnd="12dp" />

    <!-- Rule Text -->
    <TextView
        android:id="@+id/ruleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Rule text goes here"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:lineSpacingExtra="2sp" />

    <!-- Remove Button -->
    <ImageButton
        android:id="@+id/btnRemoveRule"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove rule"
        app:tint="@color/red_500"
        android:layout_marginStart="8dp" />

</LinearLayout>
