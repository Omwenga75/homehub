<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".admin.AnalyticsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <!-- Premium Navy Gradient Header (Elite V2) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary_dark"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedBottom"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_gradient_navy_radial">

                <!-- Modern Toolbar -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/id_v8_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:paddingHorizontal="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/id_v8_backCard"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="30dp"
                            app:cardBackgroundColor="#33FFFFFF"
                            app:cardElevation="0dp">

                            <ImageButton
                                android:id="@+id/id_v8_backButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_arrow_back"
                                android:scaleType="center"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/id_v8_filterCard"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="30dp"
                            app:cardBackgroundColor="#33FFFFFF"
                            app:cardElevation="0dp">

                            <ImageButton
                                android:id="@+id/id_v8_filterButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_filter"
                                android:scaleType="center"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="ANALYTICS"
                            android:textColor="#E0E0E0"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-medium" />

                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>

                <!-- Hero Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="32dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="32dp"
                        app:cardBackgroundColor="#1AFFFFFF"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#33FFFFFF">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:src="@drawable/ic_analytics"
                            app:tint="@color/secondary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Performance &amp; Insights"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="-0.01" />

                        <TextView
                            android:id="@+id/id_v8_analyticsSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Real-time platform analytics"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Gold Accent Line -->
                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_gold_line" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- Time Period Selector with Gold Active State -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/id_v8_btnWeek"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Week"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/id_v8_btnMonth"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Month"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/id_v8_btnYear"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Year"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Elite Price Range Filter Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_v8_priceRangeCard"
                android:layout_width="match_parent"                 android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
               app:cardCornerRadius="20dp"
               app:cardElevation="2dp"
               app:strokeWidth="1dp"
               app:strokeColor="#E2E8F0"/>

            <!-- Elite Price Range Filter Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_v8_priceRangeCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Price Range"
                        android:textColor="@color/primary_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minimum"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/id_v8_tvMinPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KSh 0"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/primary_dark"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>

                        <View
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:background="@color/grey_300"
                            android:layout_marginHorizontal="12dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maximum"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/id_v8_tvMaxPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KSh 200,000+"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/primary_dark"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/id_v8_priceSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:valueFrom="0.0"
                        android:valueTo="200000.0"
                        app:values="@array/id_v8_initial_price_values"
                        app:thumbColor="@color/primary"
                        app:trackColorActive="@color/primary"
                        app:trackColorInactive="@color/primary_light"
                        app:haloColor="#331A237E"
                        app:tickVisible="false"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header with Gold Accent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEY PERFORMANCE INDICATORS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@color/divider" />
            </LinearLayout>

            <!-- Key Metrics Grid - Modern Cards -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_marginBottom="24dp"
                android:rowOrderPreserved="false">

                <!-- Occupancy Card - Navy Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Occupancy Rate"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/id_v8_occupancyRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="75%"
                            android:textColor="@color/primary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pill_gold_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/secondary_dark" />

                            <TextView
                                android:id="@+id/id_v8_occupancy_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+12%"
                                android:textColor="@color/secondary_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rating Card - Gold Theme -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Average Rating"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/id_v8_averageRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="4.8"
                            android:textColor="@color/secondary"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pill_gold_light"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/secondary_dark" />

                            <TextView
                                android:id="@+id/id_v8_rating_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0.3"
                                android:textColor="@color/secondary_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Revenue Card - Full Width with Gold Accent -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_columnSpan="2"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Revenue Per Night"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/id_v8_revenuePerNight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="KSh 4,200"
                                android:textColor="@color/primary"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-black" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_pill_gold"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_trending_up"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/id_v8_revenue_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+18%"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Modern Chart Card (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WEEKLY PERFORMANCE"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"/>

                    <!-- Chart Container with Modern Bars -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:paddingTop="8dp"
                        android:weightSum="7">

                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colMon" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colTue" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colWed" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colThu" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colFri" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colSat" />
                        <include layout="@layout/view_analytics_bar_modern" android:id="@+id/colSun" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/id_v8_revenueSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Weekly Revenue: KSh 32,800"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pill_gold_light"
                        android:paddingVertical="12dp"
                        android:paddingHorizontal="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Booking Stats Card (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BOOKING DISTRIBUTION"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"/>

                    <include layout="@layout/item_analytics_booking_modern" android:id="@+id/id_v8_rowConfirmed" />
                    <include layout="@layout/item_analytics_booking_modern" android:id="@+id/id_v8_rowPending" />
                    <include layout="@layout/item_analytics_booking_modern" android:id="@+id/id_v8_rowCancelled" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginVertical="16dp" />

                    <TextView
                        android:id="@+id/id_v8_bookingSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Transactions: 25"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Strategic Insights Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRATEGIC INSIGHTS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@color/divider" />
            </LinearLayout>

            <!-- Strategic Insights (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#F1F5F9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="STRATEGIC INSIGHTS"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"/>

                    <include layout="@layout/item_analytics_insight_modern" android:id="@+id/id_v8_insight1" />
                    <include layout="@layout/item_analytics_insight_modern" android:id="@+id/id_v8_insight2" />
                    <include layout="@layout/item_analytics_insight_modern" android:id="@+id/id_v8_insight3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
