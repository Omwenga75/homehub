<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Left Aligned Review -->
    <LinearLayout
        android:id="@+id/leftReviewLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/reviewerImageLeft"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/reviewer1"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/reviewerNameLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sarah M."
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reviewDateLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="- 2 weeks ago"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Star Rating -->
            <LinearLayout
                android:id="@+id/ratingContainerLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/star1Left"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold" />

                <ImageView
                    android:id="@+id/star2Left"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star3Left"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star4Left"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star5Left"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <TextView
                    android:id="@+id/ratingTextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="5.0"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_light">

                <TextView
                    android:id="@+id/reviewTextLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Great place to stay!"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <!-- Right Aligned Review -->
    <LinearLayout
        android:id="@+id/rightReviewLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/reviewDateRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- 1 month ago"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/reviewerNameRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="John K."
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Star Rating -->
            <LinearLayout
                android:id="@+id/ratingContainerRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/ratingTextRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="5.0"
                    android:textColor="@color/textSecondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/star1Right"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold" />

                <ImageView
                    android:id="@+id/star2Right"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star3Right"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star4Right"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

                <ImageView
                    android:id="@+id/star5Right"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/star"
                    app:tint="@color/gold"
                    android:layout_marginStart="2dp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/reviewTextRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="Amazing experience!"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <ImageView
            android:id="@+id/reviewerImageRight"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/reviewer2"
            android:scaleType="centerCrop"
            android:layout_marginStart="12dp" />
    </LinearLayout>
</LinearLayout>