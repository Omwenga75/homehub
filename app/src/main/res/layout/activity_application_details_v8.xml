<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ApplicationDetailsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <!-- Elite Header (Navy Radial) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/primary_dark"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.RoundedBottom"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_gradient_navy_radial"
                android:paddingBottom="24dp">

                <!-- Modern Minimal Toolbar -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/id_v8_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:paddingHorizontal="12dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/id_v8_backCard"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            app:cardCornerRadius="20dp"
                            app:cardBackgroundColor="#26FFFFFF"
                            app:cardElevation="0dp">

                            <ImageButton
                                android:id="@+id/id_v8_backButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:src="@drawable/ic_arrow_back"
                                android:scaleType="center"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="APPLICATION REVIEW"
                            android:textColor="#E0E0E0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <!-- Dynamic Status Badge -->
                        <LinearLayout
                            android:id="@+id/id_v8_statusBadgeLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_review_status_pending"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/id_v8_statusIndicator"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/orange"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/id_v8_statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PENDING"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardBackgroundColor="#1AFFFFFF"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="14dp"
                            android:src="@drawable/person"
                            app:tint="@color/secondary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/id_v8_headerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:id="@+id/id_v8_headerEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="john.doe@email.com"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_gold_line" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/id_v8_nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="100dp">

            <!-- Personal Info Card (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFORMATION"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Standard Row Implementation -->
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowName" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowPhone" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowIdNumber" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowNationality" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KYC Section (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IDENTITY &amp; KYC VERIFICATION"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Capture Alignment"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E2E8F0">
                        <ImageView
                            android:id="@+id/id_v8_selfieImagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/hss6" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="National ID (Front)" android:textColor="#64748B" android:textSize="10sp" android:layout_marginBottom="6dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E2E8F0">
                                <ImageView
                                    android:id="@+id/id_v8_idCardImagePreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/hss6" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="National ID (Back)" android:textColor="#64748B" android:textSize="10sp" android:layout_marginBottom="6dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E2E8F0">
                                <ImageView
                                    android:id="@+id/id_v8_idCardBackPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/hss6" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Elite GPS Verification Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="20dp"
                        android:padding="16dp"
                        android:background="#0D3B82F6"
                        android:elevation="0dp">

                        <TextView
                            android:id="@+id/id_v8_gpsCoordinatesText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GPS: Tagged Location Verified"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_location"
                            android:drawablePadding="12dp"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/id_v8_securityStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Identity Sequence: Secure Capture"
                            android:textColor="@color/green"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/ic_check_circle"
                            android:drawablePadding="12dp"
                            app:tint="@color/green" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Property Section (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROPERTY PORTFOLIO"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowPropertyType" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowLocation" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowRooms" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowPrice" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="44dp" />

                    <TextView
                        android:id="@+id/id_v8_propertyDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="44dp"
                        android:layout_marginTop="4dp"
                        android:text="Elite apartment with modern amenities."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Amenities Card (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROPERTY AMENITIES"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/id_v8_amenitiesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="10dp"
                        app:chipSpacingVertical="10dp" />

                    <TextView
                        android:id="@+id/id_v8_noAmenitiesText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No amenities listed"
                        android:textColor="#94A3B8"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timeline Card (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APPLICATION TIMELINE"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>

                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowApplicationDate" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowReviewedBy" />
                    <include layout="@layout/view_review_info_row_v8" android:id="@+id/id_v8_rowReviewedAt" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rejection Reason (Conditional Display) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/id_v8_rejectionReasonSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#0DFF4D4D"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1AFF4D4D">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rejection Insight"
                        android:textColor="#B91C1C"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/id_v8_rejectionReasonText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Documentation mismatch detected."
                        android:textColor="#991B1B"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Admin Action Hub (Elite Synchronized) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="1dp"
                app:strokeColor="#F1F5F9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADMINISTRATION PANEL"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Internal Administration Notes"
                        android:textColor="@color/primary_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <EditText
                        android:id="@+id/id_v8_notesEditText"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_admin_input_v8"
                        android:gravity="top"
                        android:hint="Add professional internal context..."
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/id_v8_approveButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="APPROVE"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/green"
                            app:cornerRadius="16dp"
                            app:elevation="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/id_v8_rejectButton"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="REJECT"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/red"
                            app:cornerRadius="16dp"
                            app:elevation="4dp" />
                    </LinearLayout>

                    <!-- Elite Rejection Interface -->
                    <LinearLayout
                        android:id="@+id/id_v8_rejectionReasonLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Official Rejection Reason" android:textColor="#B91C1C" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/id_v8_rejectionReasonEditText"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_admin_input_v8"
                            android:gravity="top"
                            android:hint="Explain rejection to partner..."
                            android:padding="16dp"
                            android:textSize="14sp"
                            android:textColor="#991B1B" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:weightSum="10">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/id_v8_cancelRejectionButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="4"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:text="Cancel"
                                android:textColor="#64748B"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/id_v8_submitRejectionButton"
                                android:layout_width="0dp"
                                android:layout_height="50dp"
                                android:layout_weight="6"
                                android:text="Confirm Rejection"
                                android:textColor="@color/white"
                                app:backgroundTint="@color/red"
                                app:cornerRadius="12dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/id_v8_progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
